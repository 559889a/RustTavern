{
  "name": "rusttavern",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-server.mjs",
    "build:skip-web": "node scripts/build-server.mjs --skip-web-build",
    "pack:dist": "node scripts/pack-dist.mjs",
    "dev": "node scripts/dev-server.mjs",
    "check": "pnpm run check:frontend && pnpm run check:types && pnpm run check:logging-boundaries && pnpm run check:rust-boundaries && pnpm test && pnpm run check:rust:clippy",
    "check:frontend": "node scripts/check-frontend-guardrails.mjs && node scripts/check-preload-hints.mjs",
    "check:frontend:baseline": "node scripts/check-frontend-guardrails.mjs --update-baseline",
    "check:types": "tsc -p tsconfig.host.json",
    "check:logging-boundaries": "node scripts/check-logging-boundaries.mjs",
    "check:rust-boundaries": "node scripts/check-rust-crate-boundaries.mjs",
    "check:rust:dev": "cargo check --manifest-path Cargo.toml --workspace",
    "check:rust:clippy": "cargo clippy --manifest-path Cargo.toml --workspace --all-targets -- -D warnings",
    "test": "pnpm run test:contracts && pnpm run test:rust",
    "test:contracts": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:rust": "cargo test --manifest-path Cargo.toml --workspace",
    "web:build": "rspack build --config rspack.config.js",
    "web:dev": "rspack build --config rspack.config.js --watch",
    "server:dev": "cargo run --manifest-path Cargo.toml -p rusttavern",
    "server:build": "cargo build --manifest-path Cargo.toml -p rusttavern"
  },
  "devDependencies": {
    "@rspack/cli": "^2.0.8",
    "@rspack/core": "^2.0.8",
    "@types/jquery": "^3.5.33",
    "@types/jquery-cropper": "^1.0.4",
    "@types/jquery.transit": "^0.9.33",
    "@types/jqueryui": "^1.12.24",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/select2": "^4.0.63",
    "@types/toastr": "^2.1.43",
    "es-module-lexer": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@adobe/css-tools": "^4.4.4",
    "@iconfu/svg-inject": "^1.2.3",
    "@mozilla/readability": "^0.6.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/virtual-core": "3.17.7",
    "bowser": "^2.12.1",
    "chalk": "^5.6.0",
    "chevrotain": "^11.2.0",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.2",
    "droll": "^0.2.1",
    "fflate": "^0.8.2",
    "fuse.js": "^7.1.0",
    "handlebars": "^4.7.9",
    "highlight.js": "^11.11.1",
    "js-sha256": "^0.11.1",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "moment": "^2.30.1",
    "morphdom": "^2.7.7",
    "seedrandom": "^3.0.5",
    "showdown": "^2.1.0",
    "vue": "^3.5.33",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
